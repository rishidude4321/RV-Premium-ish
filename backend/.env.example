# Copia como .env y rellena los valores. No subas .env a git.

PORT=5173
TMDB_API_KEY=your_tmdb_api_key
WORKER_PROXY_URL=https://rv-plus.rishivira4321.workers.dev/
CLOUDFLARE_API_TOKEN=

# Auth0 (Dashboard: Applications → tu app → Settings)
# Domain: ej. dev-xxxxxx.us.auth0.com (sin https://)
# Callback URL debe coincidir con "Allowed Callback URLs" en Auth0
AUTH0_DOMAIN=dev-xxxxxx.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URL=http://localhost:5173

# Identifier de tu API en Auth0 (necesario para perfiles en MongoDB)
# AUTH0_AUDIENCE=https://api.tuapp.com

# MongoDB Atlas (perfiles por usuario Auth0)
# MONGODB_URI=mongodb+srv://user:password@cluster.xxx.mongodb.net/dbname?retryWrites=true&w=majority
# MONGODB_DB_NAME=movie_db
